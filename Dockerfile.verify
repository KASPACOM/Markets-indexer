FROM postgres:16-bookworm@sha256:cd0e9518bda5f2ea667ff84d22795d089720c883f288e215d97ce57437e8ef37
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/tests
COPY scripts/shadow-v2/requirements.txt /tmp/requirements.txt
RUN /opt/tests/bin/pip install --no-cache-dir -r /tmp/requirements.txt
ENV PATH="/opt/tests/bin:$PATH"
