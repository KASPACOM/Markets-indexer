    "span": "contract MultiSigVault(pubkey key1, pubkey key2, pubkey key3) {\n    // Key1 + Key2 sign\n    entry spend12(sig s1, sig s2) {\n        require(checkSig(s1, key1));\n        require(checkSig(s2, key2));\n    }\n\n    // Key1 + Key3 sign\n    entry spend13(sig s1, sig s3) {\n        require(checkSig(s1, key1));\n        require(checkSig(s3, key3));\n    }\n\n    // Key2 + Key3 sign\n    entry spend23(sig s2, sig s3) {\n        require(checkSig(s2, key2));\n        require(checkSig(s3, key3));\n    }\n\n    entry topUp() {\n        require(this.activeInputIndex == 0);\n        require(tx.outputs[0].value > tx.inputs[this.activeInputIndex].value);\n        require(tx.outputs[0].scriptPubKey == tx.inputs[this.activeInputIndex].scriptPubKey);\n    }\n}",
