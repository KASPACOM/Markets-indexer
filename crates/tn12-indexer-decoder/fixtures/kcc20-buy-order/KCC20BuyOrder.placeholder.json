    "span": "contract KCC20BuyOrder(\n    pubkey orderBuyer,\n    byte[32] orderedTokenId,\n    byte[32] orderedTokenScriptHash,\n    int orderedTokenAmount,\n    int offerPriceSompi,\n    pubkey protocolFeeRecipient,\n    int protocolFeeBps\n) {\n    int constant FEE_DENOMINATOR_BPS = 10000;\n\n    pubkey buyer = orderBuyer;\n    byte[32] tokenId = orderedTokenId;\n    byte[32] expectedTokenScriptHash = orderedTokenScriptHash;\n    int tokenAmount = orderedTokenAmount;\n    int priceSompi = offerPriceSompi;\n    pubkey feeRecipient = protocolFeeRecipient;\n    int feeBps = protocolFeeBps;\n\n    function requireSellerTokenInput(int tokenInputIndex) {\n        require(OpInputCovenantId(tokenInputIndex) == tokenId);\n    }\n\n    function requireFeePolicy() {\n        require(feeBps >= 0);\n        require(feeBps <= FEE_DENOMINATOR_BPS);\n    }\n\n    entrypoint function fillBuyOrder(int tokenInputIndex, int tokenOutputIndex, pubkey seller) {\n        requireSellerTokenInput(tokenInputIndex);\n        requireFeePolicy();\n        require(tokenAmount > 0);\n        require(priceSompi > 0);\n        require(tx.inputs[this.activeInputIndex].value == priceSompi);\n        require(tx.outputs[tokenOutputIndex].scriptPubKey == byte[](new ScriptPubKeyP2SH(expectedTokenScriptHash)));\n\n        int feeSompi = priceSompi * feeBps / FEE_DENOMINATOR_BPS;\n        int sellerNet = priceSompi - feeSompi;\n        require(sellerNet > 0);\n\n        byte[34] sellerLock = new ScriptPubKeyP2PK(seller);\n        require(tx.outputs[0].value == sellerNet);\n        require(tx.outputs[0].scriptPubKey == byte[](sellerLock));\n        if (feeSompi > 0) {\n            byte[34] feeLock = new ScriptPubKeyP2PK(feeRecipient);\n            require(tx.outputs[1].value == feeSompi);\n            require(tx.outputs[1].scriptPubKey == byte[](feeLock));\n        }\n    }\n\n    entrypoint function cancelBuyOrder(sig buyerSig, int minerFeeSompi) {\n        require(checkSig(buyerSig, buyer));\n        require(minerFeeSompi >= 0);\n\n        int refund = tx.inputs[this.activeInputIndex].value - minerFeeSompi;\n        require(refund > 0);\n        byte[34] buyerLock = new ScriptPubKeyP2PK(buyer);\n        require(tx.outputs[0].value == refund);\n        require(tx.outputs[0].scriptPubKey == byte[](buyerLock));\n    }\n}",
    "name_span": "KCC20BuyOrder"
