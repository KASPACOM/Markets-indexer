    "span": "contract KCC20Sale(\n    pubkey seller,\n    byte[32] tokenId,\n    int tokenAmount,\n    int priceSompi\n) {\n    function requireLockedTokenInput(int tokenInputIndex) {\n        require(OpInputCovenantId(tokenInputIndex) == tokenId);\n    }\n\n    entrypoint function buy(int tokenInputIndex) {\n        requireLockedTokenInput(tokenInputIndex);\n        require(tokenAmount > 0);\n\n        require(tx.outputs[0].value >= priceSompi);\n        byte[34] sellerLock = new ScriptPubKeyP2PK(seller);\n        require(tx.outputs[0].scriptPubKey == byte[](sellerLock));\n    }\n\n    entrypoint function cancel(sig sellerSig, int tokenInputIndex) {\n        require(checkSig(sellerSig, seller));\n        requireLockedTokenInput(tokenInputIndex);\n        require(tokenAmount > 0);\n    }\n}",
    "name_span": "KCC20Sale"
